---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	preprocess["preprocess<br/>清洗 / 截断"]
	classify["classify<br/>意图识别 + 规则兜底"]
	knowledge["knowledge<br/>RAG 问答"]
	query["query<br/>订单查询"]
	service["service<br/>工单草稿"]
	fallback["fallback<br/>投诉 / 闲聊 / 转人工"]
	__end__([<p>__end__</p>]):::last
	__start__ --> preprocess;
	classify -.->|fallback| fallback;
	classify -.->|knowledge| knowledge;
	classify -.->|query| query;
	classify -.->|service| service;
	preprocess --> classify;
	fallback --> __end__;
	knowledge --> __end__;
	query --> __end__;
	service --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
