flowchart TD
    U["用户输入"] --> P["preprocess<br/>清洗 / 截断"]
    P --> C["classify<br/>read / write / human"]
    C -- read --> R["规则选择只读工具"]
    R -- 订单号 / 查订单 --> Q1["order_query<br/>订单仓储查询"]
    R -- 其他只读问题 --> K1["knowledge_search<br/>HTML RAG 检索"]
    K1 --> K2["生成回答<br/>SSE: citation + token"]
    Q1 --> Q2["确定性订单回答<br/>SSE: order + token"]
    C -- write --> S1["抽取业务槽位"]
    S1 --> S2{"缺订单号 / 联系人?"}
    S2 -- 是 --> S3["追问缺失槽位"]
    S2 -- 否 --> S4["生成工单草稿<br/>SSE: service_draft<br/>用户确认后提交"]
    C -- human --> F1["投诉 / 转人工 / 闲聊兜底"]
    K2 --> E(["结束"])
    Q2 --> E
    S3 --> E
    S4 --> E
    F1 --> E
    classDef decision fill:#fff7e6,stroke:#d4a017
    class S2 decision
