# ===============================================================
# 问答工单 Agent POC - 环境配置示例
# 复制成 .env 使用。模型相关全部留空时以「演示模式(mock)」启动，
# 不联网、不需要 Key，也能跑通整条链路，方便先看效果。
# ===============================================================

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=5179
# 前端 dev server 地址，用于跨域
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------- 模型 ----------
#   mock      演示模式，不请求网络，用内置占位回答（默认）
#   deepseek  直连 DeepSeek（OpenAI 兼容协议）
#   openai    OpenAI 或任意 OpenAI 兼容端点
LLM_PROVIDER=mock

# 留空则用提供方默认模型：deepseek -> deepseek-chat，openai -> gpt-4o-mini
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120

# ---------- 四个扩展点：POC 用轻量实现，生产换同名工厂的另一个分支 ----------
# 短期记忆：memory(MemorySaver) | postgres(PostgresSaver)
CHECKPOINTER=memory
# 检索：memory(进程内检索) | pgvector
RETRIEVER=memory
# 工单存储：json(backend/data/tickets.json) | postgres
TICKET_STORE=json
# 订单存储：json(backend/data/demo/ecommerce/orders.json) | postgres
ORDER_STORE=json

# ---------- 电商演示数据（默认 backend/data/demo/ecommerce）----------
# 订单聚合视图、知识库目录与 HTML 页面路径都可以单独覆盖
# DEMO_DATA_DIR=
# ORDERS_FILE=
# KB_ROOT=
# KB_DIR=
# KB_ARTICLES_FILE=

# ---------- RAG ----------
RAG_TOP_K=3

# ---------- PGVector（RETRIEVER=pgvector 时）----------
# DATABASE_URL=postgresql+psycopg://qa_ticket:change-me@127.0.0.1:5432/qa_ticket
# PGVECTOR_COLLECTION=kb_chunk
# EMBEDDING_PROVIDER=mock
# mock 仅用于离线管线验证，不代表真实语义相似度
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_BASE_URL=

# ---------- 生产化预留 ----------
# REDIS_URL=redis://127.0.0.1:6379/0

# ---------- Langfuse 可观测性（可选）----------
# 默认关闭；填好 Key 并设置 LANGFUSE_ENABLED=true 后自动上报 LangGraph/LLM/Retriever trace
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# Cloud EU 默认地址；美国区用 https://us.cloud.langfuse.com；自托管填自己的地址
LANGFUSE_BASE_URL=https://cloud.langfuse.com
